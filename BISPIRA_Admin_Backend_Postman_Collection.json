						"description": "Mengambil antrean pembayaran pending yang menunggu verifikasi kode unik 3-digit"
					},
					"response": []
				},
				{
					"name": "Approve Payment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bank_mutation_reference\": \"MUTASI_BCA_20260913_0099\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/payments/pay_77210/approve",
							"host": ["{{base_url}}"],
							"path": ["payments", "pay_77210", "approve"]
						},
						"description": "Mengonfirmasi bahwa dana sudah masuk di mutasi bank"
					},
					"response": []
				},
				{
					"name": "Reject Payment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"Dana tidak ditemukan di mutasi rekening bank setelah dicek.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/payments/pay_77210/reject",
							"host": ["{{base_url}}"],
							"path": ["payments", "pay_77210", "reject"]
						},
						"description": "Menolak pembayaran jika transfer tidak ditemukan"
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Batch Disbursement (Pukul 17:00 WIB)",
			"item": [
				{
					"name": "Get Upcoming Disbursements",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/disbursements/upcoming",
							"host": ["{{base_url}}"],
							"path": ["disbursements", "upcoming"]
						},
						"description": "Melihat draf pencairan dana merchant batch 17:00 WIB"
					},
					"response": []
				},
				{
					"name": "Execute Batch Disbursement",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/disbursements/execute-batch",
