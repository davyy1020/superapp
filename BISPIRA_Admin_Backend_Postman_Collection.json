						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/tracking/drivers-online",
							"host": ["{{base_url}}"],
							"path": ["tracking", "drivers-online"]
						},
						"description": "Mendapatkan koordinat GPS seluruh driver online untuk peta Leaflet Admin"
					},
					"response": []
