{
	"info": {
		"_postman_id": "bispira-admin-backend-v1",
		"name": "BISPIRA Admin Backend API Collection",
		"description": "Dokumentasi & Postman Collection Resmi Endpoint Admin Backend BISPIRA SuperApp",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000/api/v1/admin",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "YOUR_JWT_TOKEN_HERE",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Auth & Admin Session",
			"item": [
				{
					"name": "Login Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin.jakarta@bispira.id\",\n  \"password\": \"PasswordSuperRahasia123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Endpoint login tim Admin (Super Admin Pusat & Admin Cabang Wilayah)"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Dynamic Tariff Settings",
			"item": [
				{
					"name": "Get Current Tariff & Fees",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/settings/financial",
							"host": ["{{base_url}}"],
							"path": ["settings", "financial"]
						},
						"description": "Mendapatkan seluruh parameter tarif dan biaya operasional platform yang sedang aktif"
					},
					"response": []
				},
				{
					"name": "Update Tariff & Fees",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tariffs\": {\n    \"ride_motor_per_km\": 2800,\n    \"service_fee\": 2500,\n    \"driver_charge_per_trip\": 500,\n    \"ambulance_base_fee\": 160000\n  },\n  \"rules\": {\n    \"branch_profit_share_percent\": 35.0,\n    \"unique_code_timer_minutes\": 30\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/settings/financial",
							"host": ["{{base_url}}"],
							"path": ["settings", "financial"]
						},
						"description": "Mengubah parameter tarif dan biaya operasional secara realtime"
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Entity Verification",
			"item": [
				{
					"name": "Get Pending Driver Verification",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/drivers/verification-pending",
							"host": ["{{base_url}}"],
							"path": ["drivers", "verification-pending"]
						},
						"description": "Mengambil antrean pendaftaran driver baru yang memerlukan verifikasi KTP/SIM/STNK/SKCK"
					},
					"response": []
				},
				{
					"name": "Approve Driver Registration",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"approval_note\": \"Dokumen KTP, SIM, STNK lengkap dan terverifikasi sah.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/drivers/drv_9921/approve",
							"host": ["{{base_url}}"],
							"path": ["drivers", "drv_9921", "approve"]
						},
						"description": "Menyetujui pendaftaran driver dan mengaktifkan akun"
					},
					"response": []
				}
			]
		},
